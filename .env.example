# =====================================================================
# DSC Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is ignored by git and will never be committed.
# =====================================================================

# Option 1: Full Connection String
# ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=dsc_db;Username=postgres;Password=your_password"

# Option 2: DATABASE_URL (Standard format or postgres:// URI)
DATABASE_URL="Host=localhost;Port=5432;Database=dsc_db;Username=postgres;Password=your_password"

# Option 3: Individual Parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dsc_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# =====================================================================
# JWT Authentication Configuration
# =====================================================================
Jwt__Key="development-only-change-this-key-to-a-secret-at-least-32-bytes"
Jwt__Issuer="DSC.Api"
Jwt__Audience="DSC.Client"
Jwt__ExpiresMinutes=60
Jwt__SecureCookie=false

# =====================================================================
# AB#161 - Correo de invitación de cuentas (SMTP). Valores ficticios.
# Copia a '.env' (ignorado por Git) y usa las credenciales reales SOLO allí.
# Sin Smtp__Host/Smtp__From las invitaciones quedan PENDING (no se pierde nada).
# =====================================================================
Smtp__Host="smtp.example.test"
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username="usuario-ficticio"
Smtp__Password="clave-ficticia"
Smtp__From="no-responder@example.test"
# Origen HTTPS del frontend para el enlace de activación (sin ruta). No se toma de la solicitud.
Activation__FrontendOrigin="https://dsc.example.test"
