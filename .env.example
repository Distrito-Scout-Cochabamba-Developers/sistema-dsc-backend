# =====================================================================
# DSC Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is ignored by git and will never be committed.
# =====================================================================

# Option 1: Full Connection String
# ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=dsc_db;Username=postgres;Password=your_password"

# Option 2: DATABASE_URL (Standard format or postgres:// URI)
DATABASE_URL="Host=localhost;Port=5432;Database=dsc_db;Username=postgres;Password=your_password"

# Option 3: Individual Parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dsc_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development
